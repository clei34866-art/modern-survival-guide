{
  "name": "modern-survival-guide",
  "private": false,
  "version": "3.0.0",
  "license": "MIT",
  "description": "现代必备生存指南 · 个人生产力与生活掌控感互动学习平台（v3.0 React + Tailwind + shadcn/ui + Motion）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch:resources": "node scripts/fetch_resources.mjs",
    "check:content": "node scripts/validate_content.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run check:content && tsc --noEmit && vite build",
    "build:pages": "npm run check:content && tsc --noEmit && vite build --mode pages",
    "deploy:pages": "node scripts/deploy_pages.mjs",
    "smoke": "node scripts/smoke_test.mjs",
    "verify:ui": "node scripts/verify_ui.mjs",
    "check:all": "npm run build && npm run smoke && npm run verify:ui",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-tabs": "^1.1.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
